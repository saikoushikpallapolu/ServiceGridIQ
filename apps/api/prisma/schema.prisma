generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  active    Boolean  @default(true)
  partsFreshnessHours Int @default(24) @map("parts_freshness_hours")
  preparationPolicyVersion Int @default(1) @map("preparation_policy_version")
  parts Part[]
  stockLocations StockLocation[]
  memberships Membership[]
  sessions AuthSession[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  customers Customer[]
  sites ServiceSite[]
  equipment Equipment[]
  jobs Job[]
  branches Branch[]
  skills Skill[]

  @@map("organizations")
}

enum Role {
  OWNER
  DISPATCHER
  TECHNICIAN
}

model User {
  id String @id @default(uuid()) @db.Uuid
  issuer String
  subject String
  email String
  name String
  active Boolean @default(true)
  memberships Membership[]
  sessions AuthSession[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([issuer, subject])
  @@map("users")
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role Role
  active Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations Invitation[]
  auditEvents AuditEvent[]
  jobEvents JobEvent[]
  technician Technician?
  verifiedSkills TechnicianSkill[] @relation("SkillVerifier")
  partConfirmations PartConfirmation[]
  prerequisiteEvidence PrerequisiteEvidence[]
  approvals Assignment[]
  idempotencies IdempotencyRecord[]
  observations VisitObservation[]
  visitClosures VisitClosure[]
  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@map("memberships")
}

enum JobStatus {
  DRAFT
  TRIAGED
  READY
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum JobType {
  INITIAL
  FOLLOW_UP
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String
  email String?
  phone String?
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sites ServiceSite[]
  @@unique([organizationId, id])
  @@index([organizationId, name, id])
  @@map("customers")
}

model ServiceSite {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  name String
  address String
  accessNotes String @default("") @map("access_notes")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  equipment Equipment[]
  jobs Job[]
  @@unique([organizationId, id])
  @@unique([organizationId, customerId, id])
  @@index([organizationId, customerId])
  @@map("service_sites")
}

model Equipment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId String @map("site_id") @db.Uuid
  manufacturer String
  model String
  serialNumber String @map("serial_number")
  notes String @default("")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site ServiceSite @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  jobs Job[]
  @@unique([organizationId, id])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId])
  @@map("equipment")
}

model Job {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  siteId String @map("site_id") @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  jobType JobType @default(INITIAL) @map("job_type")
  parentJobId String? @unique @map("parent_job_id") @db.Uuid
  rootJobId String? @map("root_job_id") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String? @map("cancellation_reason")
  parent Job? @relation("FollowUpParent", fields: [organizationId, parentJobId], references: [organizationId, id], onDelete: Restrict)
  followUp Job? @relation("FollowUpParent")
  root Job? @relation("FollowUpRoot", fields: [organizationId, rootJobId], references: [organizationId, id], onDelete: Restrict)
  descendants Job[] @relation("FollowUpRoot")
  observations VisitObservation[]
  closure VisitClosure?
  complaint String
  serviceCategory String @default("GENERAL_SERVICE") @map("service_category")
  plannedStart DateTime? @map("planned_start") @db.Timestamptz(3)
  visitRevision Int @default(1) @map("visit_revision")
  partsReviewed Boolean @default(false) @map("parts_reviewed")
  prerequisitesReviewed Boolean @default(false) @map("prerequisites_reviewed")
  warningAcknowledgments Json @default("{}") @map("warning_acknowledgments")
  readySnapshot Json? @map("ready_snapshot")
  priority JobPriority @default(NORMAL)
  status JobStatus @default(DRAFT)
  arrivalStart DateTime @map("arrival_start") @db.Timestamptz(3)
  arrivalEnd DateTime @map("arrival_end") @db.Timestamptz(3)
  estimatedDurationMinutes Int @map("estimated_duration_minutes")
  travelBufferMinutes Int @map("travel_buffer_minutes")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site ServiceSite @relation(fields: [organizationId, customerId, siteId], references: [organizationId, customerId, id], onDelete: Restrict)
  equipment Equipment @relation(fields: [organizationId, siteId, equipmentId], references: [organizationId, siteId, id], onDelete: Restrict)
  events JobEvent[]
  scheduling JobScheduling?
  reservations AppointmentReservation[]
  partRequirements JobPart[]
  prerequisites JobPrerequisite[]
  assignments Assignment[]
  @@unique([organizationId, id])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, priority])
  @@unique([organizationId, parentJobId])
  @@index([organizationId, rootJobId])
  @@index([organizationId, equipmentId, createdAt])
  @@map("jobs")
}

model JobEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  actorMembershipId String @map("actor_membership_id") @db.Uuid
  kind String
  note String
  details Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, jobId, createdAt, id])
  @@map("job_events")
}

model AuthSession {
  tokenHash String @id @map("token_hash")
  userId String @map("user_id") @db.Uuid
  activeOrganizationId String? @map("active_organization_id") @db.Uuid
  csrfToken String @map("csrf_token")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginTransaction {
  stateHash String @id @map("state_hash")
  verifier String
  nonce String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("login_transactions")
}

model Invitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  createdByMembershipId String @map("created_by_membership_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  email String
  role Role
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator Membership @relation(fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@map("invitations")
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorMembershipId String @map("actor_membership_id") @db.Uuid
  action String
  targetId String @map("target_id")
  details Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, createdAt, id])
  @@map("audit_events")
}

model Branch {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String
  nameKey String @map("name_key")
  address String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technicians Technician[]
  policies JobScheduling[]
  stockLocations StockLocation[]
  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@map("branches")
}

model Skill {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String
  nameKey String @map("name_key")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technicians TechnicianSkill[]
  requirements JobSkillRequirement[]
  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@map("skills")
}

model Technician {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  membershipId String @unique @map("membership_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  active Boolean @default(true)
  safetyRestricted Boolean @default(false) @map("safety_restricted")
  version Int @default(1)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  skills TechnicianSkill[]
  availability Availability[]
  reservations AppointmentReservation[]
  assignments Assignment[]
  @@unique([organizationId, id])
  @@unique([organizationId, membershipId])
  @@map("technicians")
}

model TechnicianSkill {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  technicianId String @map("technician_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  level Int
  active Boolean @default(true)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
  verifiedByMembershipId String @map("verified_by_membership_id") @db.Uuid
  evidence String
  technician Technician @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)
  skill Skill @relation(fields: [organizationId, skillId], references: [organizationId, id], onDelete: Restrict)
  verifier Membership @relation("SkillVerifier", fields: [organizationId, verifiedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, technicianId, skillId])
  @@map("technician_skills")
}

enum AvailabilityKind {
  SHIFT
  UNAVAILABLE
}

model Availability {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  technicianId String @map("technician_id") @db.Uuid
  kind AvailabilityKind
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  reason String
  technician Technician @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, technicianId, startsAt])
  @@map("availability")
}

model JobScheduling {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @unique @map("job_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  allowCrossBranch Boolean @default(false) @map("allow_cross_branch")
  generalInspection Boolean @default(false) @map("general_inspection")
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  requirements JobSkillRequirement[]
  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@map("job_scheduling")
}

model JobSkillRequirement {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  schedulingId String @map("scheduling_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  level Int
  scheduling JobScheduling @relation(fields: [organizationId, schedulingId], references: [organizationId, id], onDelete: Restrict)
  skill Skill @relation(fields: [organizationId, skillId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, schedulingId, skillId])
  @@map("job_skill_requirements")
}

model AppointmentReservation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  technicianId String @map("technician_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  active Boolean @default(true)
  reservedFrom DateTime @map("reserved_from") @db.Timestamptz(3)
  plannedStart DateTime @map("planned_start") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  technician Technician @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  assignment Assignment?
  @@unique([organizationId, jobId, technicianId, id])
  @@index([organizationId, technicianId, reservedFrom])
  @@map("appointment_reservations")
}

enum PartRequirementState {
  SUSPECTED
  REQUIRED
  NOT_NEEDED
}

enum EvidenceStatus {
  CONFIRMED
  UNAVAILABLE
  UNKNOWN
}

model Part {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sku String
  name String
  unit String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requirements JobPart[]
  observations VisitObservation[]
  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@map("parts")
}

model StockLocation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  name String
  kind String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  requirements JobPart[]
  @@unique([organizationId, id])
  @@unique([organizationId, branchId, name])
  @@map("stock_locations")
}

model JobPart {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  partId String @map("part_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  quantity Decimal @db.Decimal(12,3)
  state PartRequirementState
  reason String
  revision Int @default(1)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  part Part @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  confirmations PartConfirmation[]
  @@unique([organizationId, id])
  @@unique([organizationId, jobId, partId, locationId])
  @@map("job_parts")
}

model PartConfirmation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobPartId String @map("job_part_id") @db.Uuid
  recordedJobVersion Int @map("recorded_job_version")
  requirementRevision Int @map("requirement_revision")
  visitRevision Int @map("visit_revision")
  plannedStart DateTime @map("planned_start") @db.Timestamptz(3)
  status EvidenceStatus
  note String
  confirmedAt DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  confirmedByMembershipId String @map("confirmed_by_membership_id") @db.Uuid
  requirement JobPart @relation(fields: [organizationId, jobPartId], references: [organizationId, id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, confirmedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, jobPartId, confirmedAt, id])
  @@map("part_confirmations")
}

model JobPrerequisite {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  code String
  kind String
  label String
  rationale String
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  evidence PrerequisiteEvidence[]
  @@unique([organizationId, id])
  @@unique([organizationId, jobId, code])
  @@map("job_prerequisites")
}

model PrerequisiteEvidence {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid
  recordedJobVersion Int @map("recorded_job_version")
  visitRevision Int @map("visit_revision")
  plannedStart DateTime @map("planned_start") @db.Timestamptz(3)
  status String
  note String
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
  verifiedByMembershipId String @map("verified_by_membership_id") @db.Uuid
  prerequisite JobPrerequisite @relation(fields: [organizationId, prerequisiteId], references: [organizationId, id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, verifiedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, prerequisiteId, verifiedAt, id])
  @@map("prerequisite_evidence")
}

model Assignment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  technicianId String @map("technician_id") @db.Uuid
  reservationId String @unique @map("reservation_id") @db.Uuid
  approvedByMembershipId String @map("approved_by_membership_id") @db.Uuid
  approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz(3)
  readinessSnapshot Json @map("readiness_snapshot")
  rankingSnapshot Json @map("ranking_snapshot")
  approvalReason String @map("approval_reason")
  active Boolean @default(true)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  releaseKind String? @map("release_kind")
  releaseReason String? @map("release_reason")
  observations VisitObservation[]
  closure VisitClosure?
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  technician Technician @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)
  reservation AppointmentReservation @relation(fields: [organizationId, jobId, technicianId, reservationId], references: [organizationId, jobId, technicianId, id], onDelete: Restrict)
  approver Membership @relation(fields: [organizationId, approvedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  outbox OutboxEvent[]
  @@unique([organizationId, id])
  @@unique([organizationId, jobId, id])
  @@unique([organizationId, jobId, technicianId, reservationId])
  @@index([organizationId, technicianId, resolvedAt])
  @@map("assignments")
}

model IdempotencyRecord {
  organizationId String @map("organization_id") @db.Uuid
  key String @db.VarChar(100)
  requestHash String @map("request_hash")
  actorMembershipId String @map("actor_membership_id") @db.Uuid
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor Membership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@id([organizationId, key])
  @@map("idempotency_records")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  kind String
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  assignment Assignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, assignmentId, kind])
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model VisitObservation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  actorMembershipId String @map("actor_membership_id") @db.Uuid
  kind String
  note String
  recordedJobVersion Int @map("recorded_job_version")
  partId String? @map("part_id") @db.Uuid
  partLabel String? @map("part_label")
  quantity Decimal? @db.Decimal(12,3)
  correctsId String? @map("corrects_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  assignment Assignment @relation(fields: [organizationId, jobId, assignmentId], references: [organizationId, jobId, id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  part Part? @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  corrects VisitObservation? @relation("ObservationCorrection", fields: [organizationId, jobId, assignmentId, correctsId], references: [organizationId, jobId, assignmentId, id], onDelete: Restrict)
  corrections VisitObservation[] @relation("ObservationCorrection")
  @@unique([organizationId, id])
  @@unique([organizationId, jobId, assignmentId, id])
  @@index([organizationId, assignmentId, createdAt, id])
  @@map("visit_observations")
}

model VisitClosure {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId String @unique @map("job_id") @db.Uuid
  assignmentId String @unique @map("assignment_id") @db.Uuid
  actorMembershipId String @map("actor_membership_id") @db.Uuid
  outcome String
  followUpReason String? @map("follow_up_reason")
  notes String
  closedAt DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  job Job @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  assignment Assignment @relation(fields: [organizationId, jobId, assignmentId], references: [organizationId, jobId, id], onDelete: Restrict)
  actor Membership @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, jobId])
  @@unique([organizationId, jobId, assignmentId])
  @@map("visit_closures")
}
