    "/api/v1/knowledge/jobs/{id}/prepare": {
      "post": {
        "operationId": "retrieveCitedPreparationEvidence",
        "description": "Owner/dispatcher or actively assigned technician only. Exact normalized equipment manufacturer/model, approved READY current-revision sources and company scope. Local full-text search without a key. Explicit useAi can invoke configured OpenAI only for consented documents; embeddings + lexical rank use a heuristic similarity cutoff, not confidence. Provider failures fall back to clearly labelled cited search. AI selects verbatim validated source quotes with uncertainty/gaps; never executes instructions or approves readiness. Current authorization, job context and source revisions are rechecked before returning.",
        "security": [
          {
            "Session": []
          }
        ],
        "parameters": [
          {
            "name": "X-Organization-Id",
            "in": "header",
            "required": true,
